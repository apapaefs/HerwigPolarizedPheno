# -*- ThePEG-repository -*-

############################################################
# STAR polarized pp at sqrt(s)=510 GeV: shared full-event setup
############################################################

read snippets/PPCollider.in
read snippets/PolarizedPP.in

set /Herwig/EventHandlers/Luminosity:Energy 510.0*GeV

set /Herwig/Partons/HardLOPDF:PDFName NNPDF40_nlo_pch_as_01180
set /Herwig/Partons/HardNLOPDF:PDFName NNPDF40_nlo_pch_as_01180
set /Herwig/Partons/ShowerLOPDF:PDFName NNPDF40_nlo_pch_as_01180
set /Herwig/Partons/ShowerNLOPDF:PDFName NNPDF40_nlo_pch_as_01180
set /Herwig/Partons/MPIPDF:PDFName NNPDF40_nlo_pch_as_01180

create ThePEG::LHAPDF /Herwig/Partons/STARPolarizedPDF ThePEGLHAPDF.so
set /Herwig/Partons/STARPolarizedPDF:PDFName NNPDFpol20_nlo_as_01180
set /Herwig/Partons/STARPolarizedPDF:RemnantHandler /Herwig/Partons/HadronRemnants
set /Herwig/Partons/PPPolarizedExtractor:FirstPDF /Herwig/Partons/HardLOPDF
set /Herwig/Partons/PPPolarizedExtractor:SecondPDF /Herwig/Partons/HardLOPDF
set /Herwig/Partons/PPPolarizedExtractor:FirstLongitudinalDifferencePDF /Herwig/Partons/STARPolarizedPDF
set /Herwig/Partons/PPPolarizedExtractor:SecondLongitudinalDifferencePDF /Herwig/Partons/STARPolarizedPDF

# QCD and QED showering, spin-correlated decays, hadronization, remnants,
# and the tuned underlying event remain active in the nominal prediction.
set /Herwig/Shower/ShowerHandler:Interactions QEDQCD
set /Herwig/Shower/ShowerHandler:SpinCorrelations Yes
set /Herwig/Shower/ShowerHandler:MPIHandler /Herwig/UnderlyingEvent/MPIHandler

set /Herwig/EventHandlers/EventHandler:Cuts:ScaleMin 2.0*GeV2
set /Herwig/EventHandlers/EventHandler:Cuts:X1Min 1.0e-5
set /Herwig/EventHandlers/EventHandler:Cuts:X2Min 1.0e-5
set /Herwig/Samplers/Sampler:BinSampler:InitialPoints 10000

cd /Herwig/Generators
set EventGenerator:DebugLevel 0
set EventGenerator:PrintEvent 0
set EventGenerator:DumpPeriod -1
set EventGenerator:MaxWarnings 20
set EventGenerator:MaxErrors 1000000
read snippets/Rivet.in
insert /Herwig/Analysis/Rivet:Analyses 0 STAR_2019_I1708793

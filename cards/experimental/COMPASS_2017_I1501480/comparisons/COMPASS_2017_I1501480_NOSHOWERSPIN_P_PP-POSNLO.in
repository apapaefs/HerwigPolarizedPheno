# -*- ThePEG-repository -*-
read ../COMPASS_2017_I1501480-Common.in
set /Herwig/EventHandlers/EventHandler:BeamB /Herwig/Particles/p+
set /Herwig/EventHandlers/FixedTargetLuminosity:TargetParticle /Herwig/Particles/p+
set /Herwig/Partons/EPPolarizedExtractor:FirstLongitudinalPolarization 1
set /Herwig/Partons/EPPolarizedExtractor:SecondLongitudinalPolarization 1
set /Herwig/MatrixElements/PowhegMEDISNCPol:UsePOWHEGRealSpinVertex No
set /Herwig/Shower/ShowerHandler:SpinCorrelations No
set /Herwig/MatrixElements/PowhegMEDISNCPol:Contribution PositiveNLO
cd /Herwig/Generators
saverun COMPASS_2017_I1501480_NOSHOWERSPIN_P_PP-POSNLO EventGenerator

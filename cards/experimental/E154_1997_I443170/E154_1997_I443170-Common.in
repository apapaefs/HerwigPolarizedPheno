# -*- ThePEG-repository -*-

############################################################
# E154 inclusive electron DIS: approximate published-mean-Q2 windows
# Free-neutron prediction for the published nuclear-extracted A1n.
############################################################

read snippets/EPCollider.in
read snippets/PolarizedEP.in
read snippets/FixedTarget.in

set /Herwig/Particles/e-:PDF /Herwig/Partons/NoPDF
set /Herwig/EventHandlers/EventHandler:BeamA /Herwig/Particles/e-
set /Herwig/EventHandlers/EventHandler:BeamB /Herwig/Particles/n0
set /Herwig/EventHandlers/FixedTargetLuminosity:BeamParticle /Herwig/Particles/e-
set /Herwig/EventHandlers/FixedTargetLuminosity:BeamEMaxA 48.3*GeV
set /Herwig/EventHandlers/FixedTargetLuminosity:TargetParticle /Herwig/Particles/n0
set /Herwig/EventHandlers/EventHandler:LuminosityFunction /Herwig/EventHandlers/FixedTargetLuminosity

############################################################
# ThePEG LHAPDF applies its neutron u<->d isospin map to n0
############################################################

create ThePEG::LHAPDF /Herwig/Partons/E154PDF ThePEGLHAPDF.so
set /Herwig/Partons/E154PDF:PDFName NNPDF40_nlo_pch_as_01180
set /Herwig/Partons/E154PDF:RemnantHandler /Herwig/Partons/HadronRemnants
set /Herwig/Particles/p+:PDF /Herwig/Partons/E154PDF
set /Herwig/Particles/n0:PDF /Herwig/Partons/E154PDF

create ThePEG::LHAPDF /Herwig/Partons/E154DiffPDF
set /Herwig/Partons/E154DiffPDF:PDFName NNPDFpol20_nlo_as_01180
set /Herwig/Partons/E154DiffPDF:RemnantHandler /Herwig/Partons/HadronRemnants

set /Herwig/Partons/HardLOPDF:PDFName NNPDF40_nlo_pch_as_01180
set /Herwig/Partons/HardNLOPDF:PDFName NNPDF40_nlo_pch_as_01180
set /Herwig/Partons/ShowerLOPDF:PDFName NNPDF40_nlo_pch_as_01180
set /Herwig/Partons/ShowerNLOPDF:PDFName NNPDF40_nlo_pch_as_01180
set /Herwig/Partons/EPPolarizedExtractor:SecondPDF /Herwig/Partons/E154PDF
set /Herwig/Partons/EPPolarizedExtractor:SecondLongitudinalDifferencePDF /Herwig/Partons/E154DiffPDF
set /Herwig/Shower/ShowerHandler:PDFB /Herwig/Partons/ShowerLOPDF
set /Herwig/Partons/RemnantDecayer:DISOneRemnantFallback RelaxMass

############################################################
# Generation envelope covers all three Q2 windows in E154DIS.hh.
# 48.3 GeV beam; Rivet also imposes published Eprime > 10 GeV.
# The two spectrometer acceptances/averaging weights are not reconstructed.
############################################################

set /Herwig/EventHandlers/EventHandler:Cuts:ScaleMin 0.0*GeV2
set /Herwig/EventHandlers/EventHandler:Cuts:X1Min 1.0e-6
set /Herwig/EventHandlers/EventHandler:Cuts:X2Min 1.0e-6
set /Herwig/EventHandlers/EventHandler:Cuts:MHatMin 0.0*GeV
set /Herwig/Cuts/NeutralCurrentCut:MinQ2 1.0*GeV2
set /Herwig/Cuts/NeutralCurrentCut:MaxQ2 17.0*GeV2
set /Herwig/Cuts/NeutralCurrentCut:Miny 0.01
set /Herwig/Cuts/NeutralCurrentCut:Maxy 0.95
set /Herwig/Cuts/NeutralCurrentCut:MinW2 4.0*GeV2
set /Herwig/Cuts/NeutralCurrentCut:MaxW2 1.0e10*GeV2

set /Herwig/Shower/ShowerHandler:Interactions QCD
set /Herwig/Shower/ShowerHandler:MPIHandler NULL
set /Herwig/Shower/PowhegShowerHandler:MPIHandler NULL
set /Herwig/DipoleShower/DipoleShowerHandler:MPIHandler NULL
set /Herwig/Shower/ShowerHandler:HardEmission POWHEG
set /Herwig/Shower/ShowerHandler:SpinCorrelations Yes

set /Herwig/Samplers/Sampler:BinSampler:InitialPoints 10000
set /Herwig/MatrixElements/MEDISNC:UseNativeDISWindowGeneration Yes
set /Herwig/MatrixElements/MEDISNCPol:UseNativeDISWindowGeneration Yes
set /Herwig/MatrixElements/PowhegMEDISNC:UseNativeDISWindowGeneration Yes
set /Herwig/MatrixElements/PowhegMEDISNCPol:UseNativeDISWindowGeneration Yes
insert /Herwig/MatrixElements/SubProcess:MatrixElements[0] /Herwig/MatrixElements/PowhegMEDISNCPol
set /Herwig/MatrixElements/PowhegMEDISNCPol:GammaZ Gamma
set /Herwig/MatrixElements/PowhegMEDISNCPol:UsePOWHEGRealSpinVertex Yes

set /Herwig/Model:QCD/RunningAlphaS /Herwig/Couplings/NLOAlphaS
set /Herwig/Model:QCD/AlphaS 0.118

cd /Herwig/Generators
set EventGenerator:DebugLevel 0
set EventGenerator:PrintEvent 0
set EventGenerator:DumpPeriod -1
set EventGenerator:MaxWarnings 20
set EventGenerator:MaxErrors 1000000

read snippets/Rivet.in
insert /Herwig/Analysis/Rivet:Analyses 0 E154_1997_I443170

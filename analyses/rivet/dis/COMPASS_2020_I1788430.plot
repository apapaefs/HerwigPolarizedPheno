BEGIN PLOT /COMPASS_2020_I1788430/.*
LogY=0
RatioPlot=0
YLabel=negative/positive multiplicity ratio
YMin=0.0
YMax=0.75
END PLOT
BEGIN PLOT /COMPASS_2020_I1788430/Ratio_.*_cells
XLabel=Published flattened cell
END PLOT
BEGIN PLOT /COMPASS_2020_I1788430/Ratio_pbar_over_p_xz_slice.*
